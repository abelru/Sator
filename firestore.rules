rules_version = '2';

// Leaderboard: boards/d{day}-{size}/times/{uid}
// Anyone can read. A signed-in (anonymous) player can create exactly one entry per board,
// stored under their own uid, and can't edit or delete it afterward.
service cloud.firestore {
  match /databases/{database}/documents {
    match /boards/{board}/times/{uid} {
      allow read: if board.matches('d[0-9]+-[3-8]');

      allow create: if request.auth != null
        && request.auth.uid == uid
        && board.matches('d[0-9]+-[3-8]')
        && request.resource.data.keys().hasOnly(['name', 'ms', 'at'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 16
        && request.resource.data.ms is int
        && request.resource.data.ms >= 1000
        && request.resource.data.ms <= 86400000
        && request.resource.data.at == request.time;

      allow update, delete: if false;
    }

    // Player-made squares, candidates for future daily puzzles. Write-only from the game; anyone can read
    // (they're just letters). scripts/import-squares.mjs re-checks every word before using one.
    match /squares/{id} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['n', 'rows', 'at'])
        && request.resource.data.n is int
        && request.resource.data.n >= 3
        && request.resource.data.n <= 9
        && request.resource.data.rows is string
        && request.resource.data.rows.size() == request.resource.data.n * request.resource.data.n
        && request.resource.data.rows.matches('[a-z]+')
        && request.resource.data.at == request.time;
      allow update, delete: if false;
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
